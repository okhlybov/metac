# Doxygen configuration for the metac reference manual.
# Usage: python @project@.py && doxygen Doxyfile
PROJECT_NAME           = "metac"
PROJECT_NUMBER         = @version@
PROJECT_BRIEF          = "Template engine for C source code generation"
INPUT                  = @module@_auto.h @doc_pages@
USE_MDFILE_AS_MAINPAGE = @doc_mainpage@
OUTPUT_DIRECTORY       = reference
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
MAX_INITIALIZER_LINES  = 0
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
SHOW_INCLUDE_FILES     = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
